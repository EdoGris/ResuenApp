<?xml version="1.0" encoding="utf-8"?>
<!-- Textos del Setup.exe (tema Noche, thm.xml). Mismas claves en los cuatro idiomas. -->
<WixLocalization Culture="fr-fr" Language="1036" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="Caption">Installation de [WixBundleName]</String>
  <String Id="InstallHeader">Bienvenue</String>
  <String Id="InstallMessage">[WixBundleName], votre lecteur de musique sans perte, va être installé sur cet ordinateur. Cliquez sur Installer pour continuer.</String>
  <String Id="InstallVersion">Version [WixBundleVersion]</String>
  <String Id="ConfirmCancelMessage">Voulez-vous vraiment annuler ?</String>
  <String Id="ExecuteUpgradeRelatedBundleMessage">Version précédente</String>
  <String Id="HelpHeader">Aide de l'installation</String>
  <String Id="HelpText">/install | /repair | /uninstall | /layout [dossier] - installe, répare, désinstalle
   ou copie tout le programme d'installation dans un dossier. Installer par défaut.

/passive | /quiet - fenêtre minimale sans questions, ou aucune fenêtre.

/norestart - ne redémarre jamais l'ordinateur.
/log log.txt - écrit le journal dans ce fichier. Par défaut dans %TEMP%.</String>
  <String Id="HelpCloseButton">&amp;Fermer</String>
  <String Id="InstallInstallButton">&amp;Installer</String>
  <String Id="InstallCloseButton">&amp;Fermer</String>
  <String Id="ProgressHeader">Un instant, s’il vous plaît</String>
  <String Id="OverallProgressPackageText">Préparation...</String>
  <String Id="ProgressCancelButton">&amp;Annuler</String>
  <String Id="ModifyHeader">[WixBundleName] est déjà installé</String>
  <String Id="ModifyMessage">Vous pouvez le réparer si quelque chose ne fonctionne pas, ou le désinstaller.</String>
  <String Id="ModifyRepairButton">&amp;Réparer</String>
  <String Id="ModifyUninstallButton">&amp;Désinstaller</String>
  <String Id="ModifyCloseButton">&amp;Fermer</String>
  <String Id="SuccessHeader">Terminé</String>
  <String Id="SuccessInstallHeader">Installation terminée</String>
  <String Id="SuccessRepairHeader">Réparation terminée</String>
  <String Id="SuccessUninstallHeader">Désinstallation terminée</String>
  <String Id="SuccessLaunchButton">&amp;Ouvrir</String>
  <String Id="SuccessRestartText">Redémarrez l'ordinateur pour terminer.</String>
  <String Id="SuccessRestartButton">&amp;Redémarrer</String>
  <String Id="SuccessCloseButton">&amp;Fermer</String>
  <String Id="FailureHeader">L'installation a échoué</String>
  <String Id="FailureInstallHeader">L'installation a échoué</String>
  <String Id="FailureUninstallHeader">La désinstallation a échoué</String>
  <String Id="FailureRepairHeader">La réparation a échoué</String>
  <String Id="FailureHyperlinkLogText">Un problème a empêché l'installation de se terminer. Corrigez-le et réessayez. Les détails sont dans le &lt;a href="#"&gt;journal&lt;/a&gt;.</String>
  <String Id="FailureRestartText">Redémarrez l'ordinateur pour finir d'annuler les modifications.</String>
  <String Id="FailureRestartButton">&amp;Redémarrer</String>
  <String Id="FailureCloseButton">&amp;Fermer</String>
  <String Id="ErrorFailNoActionReboot">Rien n'a été fait, car l'ordinateur doit d'abord redémarrer.</String>
</WixLocalization>
