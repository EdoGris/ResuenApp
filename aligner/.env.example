# Copia este archivo a .env y cambia el token. Es el mismo que se pega en la app
# (Ajustes → Letras → Servidor de sincronización).
ALIGNER_TOKEN=cambia-esto-por-algo-largo-y-aleatorio

# auto | cuda | cpu
ALIGNER_DEVICE=auto
# Vacío = large-v3 con GPU, small en CPU. Otras opciones: medium, large-v3-turbo.
ALIGNER_WHISPER_MODEL=
# Separar la voz con Demucs antes de alinear (más preciso, más lento).
ALIGNER_SEPARATE_VOCALS=1
ALIGNER_MAX_UPLOAD_MB=400
